# Universal Checkout — environment variables
#
# `pnpm demo` needs NONE of these: it starts a local sandbox, generates throwaway keys
# and writes everything to the git-ignored .uc/runtime.json. Set these only to run
# against testnet (or the guarded mainnet proof). Real environment variables override
# .uc/runtime.json. Never commit a filled-in copy.

# ---- Mode -------------------------------------------------------------------
# local (default) | testnet | live. `live` also requires CONFIRM_REAL_MONEY=yes.
UC_MODE=testnet
# CONFIRM_REAL_MONEY=yes

# Public base URL of the web app (used in checkout links, QR codes, pay.js).
PUBLIC_URL=http://localhost:3000
# PORT=3000

# ---- Database ---------------------------------------------------------------
# SQLite locally; Postgres (e.g. Neon) when hosted.
DATABASE_URL=file:./dev.db

# ---- NEAR -------------------------------------------------------------------
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_NETWORK_ID=testnet
UC_RECEIPTS_CONTRACT=receipts.your-name.testnet
UC_USDC_CONTRACT=usdc.your-name.testnet

# Settlement worker signer: mints receipts, posts AI decisions, executes refunds.
# Only the worker process should have this key.
UC_EXECUTOR_ACCOUNT=executor.your-name.testnet
UC_EXECUTOR_KEY=ed25519:...

# Web app signer: relays customers' signed receipt actions (pays their gas) and,
# outside live mode, creates demo accounts. Defaults to the executor if unset.
UC_RELAYER_ACCOUNT=relayer.your-name.testnet
UC_RELAYER_KEY=ed25519:...
# Parent account for demo accounts (<name>.<parent>). Defaults to the relayer.
# UC_ACCOUNT_PARENT=your-name.testnet

# ---- NEAR Intents (1Click) ---------------------------------------------------
# Optional. Without a JWT 1Click charges a 0.2% fee. testnet mode only makes dry quotes.
# ONECLICK_BASE_URL=https://1click.chaindefuser.com
# ONECLICK_JWT=
# Experimental: point testnet swaps at a Tidepool sandbox instead of the mock.
# TIDEPOOL_URL=

# ---- AI refund assistant (NEAR AI Cloud) --------------------------------------
# Optional. Without a key the deterministic rule-based assistant is used.
# NEARAI_API_KEY=
# NEARAI_BASE_URL=https://cloud-api.near.ai/v1
# NEARAI_MODEL=deepseek-ai/DeepSeek-V3.1

# ---- Email (Resend) ------------------------------------------------------------
# Optional. Without it, emails only appear on /dev/inbox (local) and in the database.
# Without a verified domain, Resend delivers only to your own account's address.
# RESEND_API_KEY=            (RESEND= is accepted too)
# EMAIL_FROM=Universal Checkout <checkout@your-domain.com>

# ---- Tuning ------------------------------------------------------------------
# Divide subscription/schedule delays by this (never applied in live mode). demo sets 43200.
# UC_TIME_SCALE=1
# UC_WORKER_INTERVAL_MS=1500

# ---- Static landing site (apps/site, e.g. on Vercel) --------------------------------
# Only for apps/site. https origin of the checkout app it links to and loads pay.js from.
# NEXT_PUBLIC_APP_URL=https://zap-2lcs3sivbq-uc.a.run.app
# Optional: shop id for the real "Try it: pay $1" button (default: first shop on the app).
# NEXT_PUBLIC_DEMO_MERCHANT=
# Optional: the static site's own https origin, for absolute share-card (Open Graph) URLs.
# NEXT_PUBLIC_SITE_URL=

