{
  "name": "near-hackathon",
  "private": true,
  "version": "0.1.0",
  "description": "NEAR Web3 hackathon workspace with agent skills, MCP, contract, and frontend",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "build:contract": "cd contract && cargo near build non-reproducible-wasm",
    "test:contract": "cd contract && cargo test --locked",
    "setup": "bash scripts/setup.sh",
    "skills:update": "npx skills update -p -y",
    "skills:add": "npx skills add near/agent-skills -y -p"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
