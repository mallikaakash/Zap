{
  "name": "universal-checkout",
  "private": true,
  "version": "0.1.0",
  "description": "Universal Checkout \u2014 pay in any coin on any chain, merchants get USDC, every payment is a receipt NFT that holds the money.",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "demo": "tsx scripts/demo.ts",
    "test": "pnpm -r --if-present test",
    "test:contracts": "cd contracts && cargo test",
    "build:contracts": "bash scripts/build-contracts.sh",
    "typecheck": "pnpm -r --if-present typecheck",
    "setup": "bash scripts/setup.sh",
    "skills:update": "npx skills update -p -y",
    "dev": "tsx scripts/dev.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "deploy:mainnet": "tsx scripts/deploy-mainnet.ts",
    "start": "tsx scripts/start.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@uc/chain": "workspace:*",
    "@uc/core": "workspace:*",
    "@uc/db": "workspace:*",
    "near-kit": "^0.20.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
