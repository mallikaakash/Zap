// Zap — off-chain state. SQLite locally, Postgres when hosted
// (scripts/use-postgres.mjs swaps the provider line; the models are identical).
// Money is always integer minor units (USDC, 6 dp) stored as strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Merchant {
  id                String   @id // NEAR account id (= the payout account for operator-registered sellers)
  name              String
  email             String?
  dashboardToken    String   @unique @default(cuid()) // secret dashboard link; the seller's login for now
  chainState        String   @default("pending") // pending | active | failed — registration on the contract (done by the worker)
  chainError        String?
  payoutAccount     String
  approverAccount   String
  guardThreshold    String   // minor units; above this even AI approvals go to the merchant
  defaultWindowSecs Int
  responseSecs      Int      @default(259200) // merchant decision window; silence = approve
  dailyRefundCap    String   @default("1000000000")
  aiTriage          Boolean  @default(true)
  autoApproveMax    String   @default("20000000")
  vetoSecs          Int      @default(43200)
  minOrder          String   @default("1000000")
  blockedRefundAddresses String @default("[]")
  webhookUrl        String?
  webhookSecret     String
  policyJson        String   @default("{}") // AI refund policy
  buttonJson        String   @default("{}") // saved button style
  createdAt         DateTime @default(now())
  products          Product[]
  sessions          Session[]
}

model Product {
  id           String   @id @default(cuid())
  merchantId   String
  merchant     Merchant @relation(fields: [merchantId], references: [id])
  name         String
  description  String   @default("")
  emoji        String   @default("🛍️")
  amount       String   // minor units, total
  kind         String   // OneTime | Subscription | Schedule
  scheduleJson String   @default("[]") // [{ afterSecs, amount }]
  windowSecs   Int?     // OneTime refund window; null = the shop default
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Session {
  id            String   @id @default(cuid())
  merchantId    String
  merchant      Merchant @relation(fields: [merchantId], references: [id])
  orderRef      String
  product       String?
  amount        String   // minor units
  kind          String   // OneTime | Subscription | Schedule
  scheduleJson  String   @default("[]") // [{ afterSecs, amount }]
  windowSecs    Int?     // OneTime refund window for this order; null = the shop default
  customerEmail String?
  metadataJson  String   @default("{}")
  // created → quoted → deposit_detected → paid → released | refund_requested → refunded ; failed | expired
  status        String   @default("created")
  originAsset   String?
  originSymbol  String?
  originChain   String?
  refundAddress String?
  orderRefHash  String   @unique // sha256(merchantId:orderRef) — what goes on chain
  receiptKey    String?  // ed25519 public key (hex) made in the customer's browser
  direct        Boolean  @default(false) // paid with USDC on NEAR straight into the contract
  fulfilment    String   @default("none") // none | shipped | delivered | digital_accessed
  trackingUrl   String?
  depositAddress String? @unique
  depositMemo   String?
  amountIn      String?
  amountInFormatted String?
  quoteDeadline DateTime?
  quoteJson     String?
  receiptId     String?  @unique
  mintTxHash    String?
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  paidAt        DateTime?

  @@unique([merchantId, orderRef])
  @@index([status])
}

// One refund request on a receipt: the off-chain half (conversation, AI decision,
// payout tracking). The on-chain `request` is the source of truth for its state.
model RefundCase {
  id             String   @id @default(cuid())
  receiptId      String
  merchantId     String
  kind           String   // refund | cancel | merchant
  amount         String   // minor units requested
  reason         String   // customer's first message (hashed on chain as reason_hash)
  refundAddress  String   @default("")
  messagesJson   String   @default("[]") // [{ role: customer|agent|merchant|system, text, imageName?, at }]
  rounds         Int      @default(0)    // clarifying questions asked so far
  // triage: none (no AI) | asking | decided (waiting for the worker to post ai_decide) | submitted
  aiState        String   @default("none")
  decisionJson   String?  // { decision, amount, category, summary, confidence, engine }
  summaryHash    String?
  customerDeadline DateTime? // reply-by time for a clarifying question
  // payout: none | sent | delivered | failed
  payoutState    String   @default("none")
  depositAddress String?
  quoteId        String?
  amountOut      String?
  amountOutFormatted String?
  quoteJson      String?
  txHash         String?
  error          String?
  closed         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([receiptId])
  @@index([merchantId])
  @@index([closed])
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  merchantId String
  event      String
  payload    String
  timestamp  Int      // unix seconds; the signature covers `${timestamp}.${payload}`
  signature  String
  status     String   @default("pending") // pending | delivered | failed | skipped
  attempts   Int      @default(0)
  lastError  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([merchantId])
}

model ChainEvent {
  id        String   @id @default(cuid())
  receiptId String?
  event     String
  dataJson  String
  txHash    String?
  createdAt DateTime @default(now())

  @@index([receiptId])
}

// Every email we send (or would send): the dev inbox in local mode, an audit log in live mode.
model Email {
  id        String   @id @default(cuid())
  to        String
  subject   String
  text      String
  html      String
  status    String   @default("queued") // queued | sent | failed | dev
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Kv {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
